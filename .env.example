# Copy to .env - never commit real secrets.

# --- Core ---------------------------------------------------------------------------------------
# Docker Compose overrides this to point at the postgres service. For local (non-Docker) dev:
DATABASE_URL=postgresql+asyncpg://lifeloop:lifeloop@localhost:5432/lifeloop
POSTGRES_PASSWORD=lifeloop
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-change-me
ENVIRONMENT=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the backend as ElevenLabs sees it (use an https tunnel such as ngrok for live voice tools)
PUBLIC_BASE_URL=http://localhost:8000

# --- ElevenLabs (leave empty to use the built-in simulated voice channel) -----------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Only for real outbound phone callbacks (Twilio number imported in ElevenLabs):
ELEVENLABS_PHONE_NUMBER_ID=
# Signing secret for the post-call webhook (ElevenLabs > Agents > Webhooks). Recommended.
ELEVENLABS_WEBHOOK_SECRET=
# Shared secret ElevenLabs sends as X-LifeLoop-Tool-Secret when the agent calls backend tools.
VOICE_TOOL_SECRET=change-me-tool-secret

# --- Optional -----------------------------------------------------------------------------------
# Reserved for caching / rate limiting / queues. Not required.
REDIS_URL=
