# LifeLoop configuration. Copy to .env and adjust. Never commit .env - it holds secrets.
# Every integration below is optional: without credentials LifeLoop runs fully offline with clearly labelled fallbacks.

# --- Runtime ------------------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_MODE=true
# Run `alembic upgrade head` (advisory-locked) and the idempotent seed when the backend starts.
RUN_MIGRATIONS_ON_STARTUP=true
SEED_ON_STARTUP=true
# Password for demo.resident@ / demo.officer@ / demo.admin@lifeloop.local (development seed only).
DEMO_USER_PASSWORD=LifeLoop-Demo-2026

# --- Host ports (change if another project already uses them) ------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the backend as ElevenLabs sees it (an https tunnel such as ngrok when tools/webhooks are live).
PUBLIC_BASE_URL=http://localhost:8000

# --- Data stores (Docker Compose overrides these with in-network addresses) ------------------------------
DATABASE_URL=postgresql+asyncpg://lifeloop:lifeloop@localhost:5432/lifeloop
POSTGRES_PASSWORD=lifeloop
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=lifeloop-neo4j

# --- Security -----------------------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Key for the keyed hash of Emirates IDs (separate from JWT_SECRET so rotating tokens never breaks matching).
PII_HASH_KEY=change-me-to-a-different-long-random-string-32+
# Shared secret ElevenLabs sends as X-LifeLoop-Tool-Secret on every server-tool call (and the initiation webhook).
VOICE_TOOL_SECRET=change-me-tool-secret

# --- Email (Gmail API; console + dev mailbox when unset) -------------------------------------------------
# base64 of the pickled OAuth credential (gmail.send scope) - mint with backend/scripts/mint_gmail_token.py
GMAIL_CREDENTIALS_B64=
GMAIL_SENDER=synfin.no.reply@gmail.com
EMAIL_FROM_NAME=LifeLoop

# --- ElevenLabs (simulated dialog engine when unset) -----------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# --- Langfuse (local structured traces when unset) -------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Twilio SMS (mock SMS when unset) --------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
